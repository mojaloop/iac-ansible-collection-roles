{
  "name": "{{ item.key }}",
  "online": true,
  "storage": {
    "blobStoreName": "default",
    "strictContentTypeValidation": false
  },
  "proxy": {
    "remoteUrl": "{{ item.value }}",
    "contentMaxAge": 1440,
    "metadataMaxAge": 1440
  },
  "negativeCache": {
    "enabled": true,
    "timeToLive": 1440
  },
  "httpClient": {
    "blocked": false,
    "autoBlock": true
  },
  "dockerProxy": {
    "indexType": "REGISTRY",
    "useTrustStoreForIndexAccess": false
  },
  "docker": {
    "v1Enabled": false,
    "forceBasicAuth": false,
    "httpPort": null,
    "httpsPort": null
  }
}